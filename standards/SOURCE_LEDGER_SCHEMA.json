{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Filmmic Foundations source evidence ledger (Edition 3.0)",
  "type": "object",
  "required": [
    "film_title",
    "film_version_viewed",
    "sources"
  ],
  "properties": {
    "film_title": {
      "type": "string",
      "minLength": 1
    },
    "film_version_viewed": {
      "type": "string",
      "minLength": 1
    },
    "last_verified": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "author",
          "title",
          "venue",
          "date",
          "url",
          "verified",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "enum": [
              "primary",
              "secondary",
              "tertiary"
            ]
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "verified": {
            "enum": [
              "verified",
              "yes",
              "true"
            ]
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "sources": {
          "contains": {
            "properties": {
              "type": {
                "const": "primary"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "sources": {
          "contains": {
            "properties": {
              "type": {
                "const": "secondary"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "sources": {
          "contains": {
            "properties": {
              "type": {
                "const": "tertiary"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      }
    }
  ]
}
