{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Filmmic Foundations figure plan (Edition 3.0)",
  "type": "object",
  "required": [
    "film_title",
    "cover",
    "still_figures"
  ],
  "properties": {
    "film_title": {
      "type": "string",
      "minLength": 1
    },
    "cover": {
      "type": "object",
      "required": [
        "path",
        "timestamp_seconds",
        "purpose"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "timestamp_seconds": {
          "type": "number",
          "minimum": 0
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "still_figures": {
      "type": "array",
      "minItems": 7,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "figure",
          "path",
          "responsive_path",
          "timestamp_seconds",
          "section_id",
          "analytical_purpose",
          "caption",
          "alt",
          "license_or_rights"
        ],
        "properties": {
          "figure": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string"
          },
          "responsive_path": {
            "type": "string"
          },
          "timestamp_seconds": {
            "type": "number",
            "minimum": 0
          },
          "section_id": {
            "type": "string"
          },
          "analytical_purpose": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "license_or_rights": {
            "type": "string"
          }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "viewer_enabled": {
            "const": false
          }
        }
      }
    }
  }
}
