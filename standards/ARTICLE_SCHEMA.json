{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Filmmic Foundations article metadata",
  "type": "object",
  "required": ["title", "description", "article_date", "film_year", "citation_title"],
  "additionalProperties": true,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "citation_title": {"type": "string", "minLength": 1},
    "citation_apa_title": {"type": "string"},
    "description": {"type": "string", "minLength": 1},
    "abstract": {"type": "string"},
    "article_date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "updated_date": {"type": "string", "format": "date"},
    "film_year": {"type": "string", "pattern": "^\\d{4}$"},
    "image": {"type": "string"},
    "image_alt": {"type": "string"},
    "genre": {"type": "array", "items": {"type": "string"}},
    "themes": {"type": "array", "items": {"type": "string"}},
    "techniques": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "language": {"type": "string", "default": "en"},
    "order": {"type": "integer", "minimum": 0}
  }
}
