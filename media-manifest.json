      "preview": [
        {
          "caption": "The final expansive shot returns the girl and dog to a valley whose newly visible contours complete the seasonal cycle.",
          "path": "assets/spring-and-autumn-over-renewed-valley.jpg"
        },
        {
          "caption": "The staff is visible before its ritual function becomes clear, linking an ordinary traveler’s tool to later communication.",
          "path": "assets/spring-shepherd-girl-with-staff.jpg"
        },
        {
          "caption": "The spirit dwarfs the human figure; its physical scale gives a small gesture extraordinary stakes.",
          "path": "assets/spring-ancient-spirit-scale.jpg"
        },
        {
          "caption": "The small illuminated chime makes an otherwise invisible exchange tangible and gives viewers a precise object to track.",
          "path": "assets/spring-first-glowing-chime.jpg"
        },
        {
          "caption": "The contrast of expansive sunlit peaks and obscured valley makes weather a measure of narrative scale.",
          "path": "assets/spring-clouds-opening-over-mountains.jpg"
        },
        {
          "caption": "The close-up of flowering plants makes seasonal renewal visible through small material details.",
          "path": "assets/spring-first-flowers-return.jpg"
